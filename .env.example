# Exemplo de Variaveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas chaves locais.

# Chave secreta criptografica para anonimizacao HMAC-SHA256 (Conformidade LGPD)
LGPD_HMAC_SECRET_KEY="defina-uma-chave-secreta-forte-aqui"

# IDs das Pastas do Data Lake no Google Drive (ou S3/MinIO bucket na infraestrutura do DataSenado)
GDRIVE_ROOT_TCC_FOLDER_ID="id_da_pasta_raiz_tcc"
GDRIVE_PLANEJAMENTO_FOLDER_ID="id_da_pasta_planejamento"
GDRIVE_REFERENCIAS_NLM_FOLDER_ID="id_da_pasta_referencias"
GDRIVE_DATASETS_LAKE_FOLDER_ID="id_da_pasta_datasets"
GDRIVE_RELATORIOS_DX_FOLDER_ID="id_da_pasta_relatorios"
GDRIVE_ESCRITA_TCC_FOLDER_ID="id_da_pasta_escrita"
